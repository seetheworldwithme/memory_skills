MEMORY_SKILLS_ACCESS_KEY=replace-with-a-long-random-key
MEMORY_SKILLS_HOST=127.0.0.1
MEMORY_SKILLS_PORT=8421
MEMORY_SKILLS_DB=data/memory-skills.db
MEMORY_SKILLS_WEB_ROOT=web/dist
# 诊断与审计事件输出：jsonl（默认）/ stderr / off
MEMORY_SKILLS_EVENT_SINK=jsonl
# JSONL 事件文件路径（仅 jsonl 模式生效）
MEMORY_SKILLS_EVENT_LOG=data/events.jsonl
# LLM Provider：mock（默认，不产生费用）/ openai（OpenAI 兼容协议）
MEMORY_SKILLS_LLM_PROVIDER=mock
# 模型名（非 mock Provider 必填），如 gpt-4o-mini
MEMORY_SKILLS_LLM_MODEL=
# 兼容端点地址；openai Provider 默认 https://api.openai.com/v1，可指向任何 OpenAI 兼容服务
MEMORY_SKILLS_LLM_BASE_URL=
# 单次尝试超时毫秒数（默认 30000）与额外重试次数（默认 2）
MEMORY_SKILLS_LLM_TIMEOUT_MS=30000
MEMORY_SKILLS_LLM_MAX_RETRIES=2
# 结构化输出模式：json_object（默认，最大兼容）/ json_schema（官方结构化输出）
MEMORY_SKILLS_LLM_RESPONSE_MODE=json_object
# 密钥所在环境变量的"名称"（不是密钥本身）；openai Provider 默认 OPENAI_API_KEY
MEMORY_SKILLS_LLM_API_KEY_ENV=MEMORY_SKILLS_LLM_API_KEY
# 模型密钥值（只存在于本文件，不入库、不进日志）
MEMORY_SKILLS_LLM_API_KEY=
# 真实模型冒烟开关：只有设为 1 时 scripts/smoke-model-provider.mjs 才会调用真实 API
MEMORY_SKILLS_SMOKE=
